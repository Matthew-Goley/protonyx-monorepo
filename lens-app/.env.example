# lens-app environment
# Copy this file to .env and fill in real values. .env is gitignored.
# Only VITE_-prefixed vars are exposed to the app; every one of them is inlined
# into the client bundle at build time, so nothing here is a secret.

# Fastify backend base URL (auth, /me, positions, settings, Stripe).
# Optional: @/lib/backend falls back to http://localhost:3000 when unset.
VITE_API_URL=http://localhost:3000

# lens-api (Python analytics engine) base URL. Required.
VITE_LENS_API_URL=https://your-lens-api-host.example.com

# lens-api X-API-Key. Required.
# Reaches the browser (see the security note in src/api/lens.ts) - use a key
# scoped to this app, not a shared secret.
VITE_LENS_API_KEY=your-lens-api-key

# Base URL of the referral service (referral-service/, FastAPI on Railway).
# Dev default when unset is http://localhost:8000.
# Prod: the deployed referral-service Railway URL.
VITE_REFERRAL_API_URL="http://localhost:8000"

# Base URL of the Fastify backend (backend/), which owns the `users` table the
# site's login/signup page authenticates against.
# Dev default when unset is http://localhost:3000.
# Prod: MUST be https://api.lens-arc.com, never the raw *.up.railway.app host.
# The session cookie is the only browser auth path, and only the
# api.lens-arc.com form is same-site with lens-arc.com, which keeps that cookie
# first-party. On the Railway host it is a third-party cookie that Safari and
# any third-party-cookie-blocking browser drops, so login succeeds and every
# authenticated call afterwards 401s.
VITE_API_URL="http://localhost:3000"

# Base URL of the referral service (referral-service/, FastAPI on Railway).
# Dev default when unset is http://localhost:8000.
# Prod: the deployed referral-service Railway URL.
VITE_REFERRAL_API_URL="http://localhost:8000"

# Base URL of the Fastify backend (backend/), which owns the `users` table the
# site's login/signup page authenticates against.
# Optional: when unset, src/lib/authApi.ts falls back to http://localhost:3000
# in a dev build and https://api.lens-arc.com in a production build, so both
# work out of the box. Set it only to point at something else (a staging API).
# If you DO set it for production it must stay on api.lens-arc.com, never the
# raw *.up.railway.app host: the session cookie is the only browser auth path,
# and only the api.lens-arc.com form is same-site with lens-arc.com, which keeps
# that cookie first-party. On the Railway host it is a third-party cookie that
# Safari and any third-party-cookie-blocking browser drops, so login succeeds
# and every authenticated call afterwards 401s.
VITE_API_URL="https://api.lens-arc.com"
